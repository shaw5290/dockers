# ===== 基础配置 =====
APP_ENV=production
APP_ADDR=:8080
WEB_ORIGIN=http://localhost:8080
WEB_DIST_DIR=/opt/plaindoc/apps/web/dist

# ===== 数据库配置 =====
DB_DRIVER=sqlite
DB_DSN=file:/opt/plaindoc/data/plaindoc.db?_pragma=busy_timeout(5000)&_pragma=journal_mode(WAL)

# ===== JWT 密钥（必须显式设置） =====
JWT_SECRET=x2U7sdFMKJ1NOIDwQcYjhyoVqnZzmaXuf3AbC865HgS0WprRTPL4kEBvGlet9i

# ===== SSR Worker 配置 =====
SSR_WORKER_ENABLED=true
SSR_WORKER_EXEC=node
SSR_WORKER_ENTRY=/opt/plaindoc/apps/web/dist-ssr/worker-entry.js